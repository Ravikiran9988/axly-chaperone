# ==============================================================================
# AXLY Chaperone Frontend — Environment Configuration Example
# Copy this file to .env before running in development or building.
# NEVER put admin API keys, agent API keys, or secrets in VITE_* variables!
# ==============================================================================

# Base URL of the AXLY Chaperone backend API.
# Leave empty ("") to use the same-origin Vite dev proxy (recommended for HttpOnly session + CSRF cookies),
# OR set an explicit origin (e.g. http://127.0.0.1:8000) when CORS allow_credentials is configured on the backend.
VITE_API_BASE_URL=

# Optional HTTP request timeout in milliseconds (default: 15000)
VITE_API_TIMEOUT_MS=15000

# Authentication uses backend-managed HttpOnly session cookies + double-submit X-CSRF-Token headers
# via /api/v1/auth/login, /api/v1/auth/session, and /api/v1/auth/logout.
# Do NOT store API keys, tokens, or credentials in VITE_* variables or browser localStorage.

# Vite dev-server proxy target when using relative URLs (VITE_API_BASE_URL="")
VITE_PROXY_TARGET=http://127.0.0.1:8000
