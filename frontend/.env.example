# ==============================================================================
# AXLY Chaperone Frontend — Environment Configuration Example
# Copy this file to .env before running in development or building.
# NEVER put admin API keys, agent API keys, or secrets in VITE_* variables!
# ==============================================================================

# Base URL of the AXLY Chaperone backend API.
# Leave empty ("") to use the Vite dev proxy (recommended for local dev without CORS edits),
# OR set an explicit origin (e.g. http://127.0.0.1:8000) when CORS is configured on the backend.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional HTTP request timeout in milliseconds (default: 15000)
VITE_API_TIMEOUT_MS=15000

# Authentication mode:
# - admin_key (current backend): validates X-Admin-Key held strictly in browser memory
# - session_cookie (Phase 4 contract): uses HTTP-only cookies with withCredentials=true
VITE_AUTH_MODE=admin_key

# Vite dev-server proxy target when using relative URLs (VITE_API_BASE_URL="")
VITE_PROXY_TARGET=http://127.0.0.1:8000
