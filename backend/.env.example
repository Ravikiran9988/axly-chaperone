# ==============================================================================
# AXLY Chaperone — Environment Configuration Example
# Copy this file to .env and fill in real values before starting the server.
# NEVER commit .env or real secrets to version control.
# ==============================================================================

# Environment: development | staging | production | test
CHAPERONE_ENV=development
CHAPERONE_APP_NAME=AXLY Chaperone
CHAPERONE_APP_VERSION=0.1.0
CHAPERONE_LOG_LEVEL=INFO
CHAPERONE_LOG_JSON=true

# PostgreSQL Async SQLAlchemy URL
# Example: postgresql+asyncpg://chaperone_user:STRONG_PASSWORD@localhost:5432/axly_chaperone
CHAPERONE_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/axly_chaperone
CHAPERONE_DB_ECHO=false
CHAPERONE_DB_POOL_SIZE=10
CHAPERONE_DB_MAX_OVERFLOW=20

# Administrative Bootstrap Secret (REQUIRED — never hardcode in source)
# Generate a strong secret with:
#   python -m app.cli generate-admin-key
CHAPERONE_ADMIN_API_KEY=

# Optional global cryptographic pepper mixed into agent API key verification.
# If set, do not rotate without re-issuing agent API keys.
CHAPERONE_API_KEY_PEPPER=

# PBKDF2-HMAC-SHA256 iterations for API key hashing (default 200000; lower only in unit tests)
CHAPERONE_API_KEY_HASH_ITERATIONS=200000

# CORS Configuration (JSON array of allowed origins; empty disables cross-origin requests)
# Example: ["http://localhost:3000","https://console.example.com"]
CHAPERONE_CORS_ORIGINS=[]
CHAPERONE_CORS_ALLOW_METHODS=["GET","POST","PATCH"]
CHAPERONE_CORS_ALLOW_HEADERS=["Content-Type","X-Admin-Key","X-Agent-Key","X-Correlation-ID"]

# Rate Limiting Strategy (Phase 1 in-memory sliding window per client/key)
CHAPERONE_RATE_LIMIT_ENABLED=true
CHAPERONE_RATE_LIMIT_REQUESTS=120
CHAPERONE_RATE_LIMIT_WINDOW_SECONDS=60

# Security limits on gateway payloads
CHAPERONE_MAX_RESOURCE_LENGTH=1024
CHAPERONE_MAX_REQUEST_BODY_BYTES=262144

# Phase 2: Sandbox, Approvals, and Execution Controls
CHAPERONE_SANDBOX_DIR=sandbox_data
CHAPERONE_APPROVAL_TTL_SECONDS=900
CHAPERONE_TOOL_EXECUTION_TIMEOUT_SECONDS=5.0
CHAPERONE_MAX_FILE_SIZE_BYTES=1048576
CHAPERONE_MAX_ARGUMENT_PAYLOAD_BYTES=32768
# Optional agent key used by local stdio MCP server instances
# CHAPERONE_MCP_AGENT_KEY=

# Optional isolated test database URL (defaults to isolated temp SQLite if unset)
# CHAPERONE_TEST_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/axly_chaperone_test
